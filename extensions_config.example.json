      "description": "Optional anonymous Parallel Search tools for web search and fetching requested URLs"
    },
    "qwen-enhanced-search": {
      "enabled": false,
      "type": "http",
      "url": "https://dashscope.aliyuncs.com/api/v1/mcps/EnhancedSearch/mcp",
