      "tool_name_prefix": true,
      "session_init_timeout": 60,
      "tool_call_timeout": 60,
      "description": "GitHub MCP server"
    },
    "parallel-search": { "enabled": false, "type": "http", "url": "https://search.parallel.ai/mcp", "description": "Optional search MCP server" },
    "openviking": { "enabled": false, "type": "http", "url": "http://127.0.0.1:1933/mcp", "headers": { "X-API-Key": "$OPENVIKING_API_KEY" }, "description": "OpenViking MCP server" },
    "postgres": { "enabled": false, "type": "stdio", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-postgres", "postgresql://localhost/mydb"], "env": {}, "description": "PostgreSQL MCP server" },
    "long-running-reports": {
      "enabled": false,
      "type": "http",
      "url": "https://reports.example.com/mcp",
      "description": "Example report MCP server",
      "session_init_timeout": 60,
      "tool_call_timeout": 60,
      "task_toolsets": [{ "name": "report-generation", "submit_tool": "submit_report", "status_tool": "get_report_status", "cancel_tool": "cancel_report" }]
    },
    "qwen-enhanced-search": {
      "enabled": false,
      "type": "http",
