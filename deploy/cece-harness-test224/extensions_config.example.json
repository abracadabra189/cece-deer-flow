      "enabled": false,
      "type": "http",
      "url": "http://172.20.28.224:18911/cece-mcp-servers/person/stream",
      "headers": { "Authorization": "$CECE_MCP_PERSON_AUTHORIZATION" },
      "tool_name_prefix": true,
      "session_init_timeout": 60,
      "description": "Person profile MCP server",
      "routing": { "mode": "prefer", "priority": 90, "keywords": ["person", "人物", "人物画像", "高管", "企业家", "简历", "任职", "履历"] }
