# Read-only DSN. Create the role first; see README.md.
#
# Never put the superuser (cece) here. Use the dedicated ops_readonly role.
#
# Option A — ops runs in Docker on the same host (recommended):
#   join the application network and address Postgres by container name.
#   dev172 network: cece-harness-dev172-net
#   test224 network: cece-harness-test224-net
# OPS_DATABASE_URL=postgresql+asyncpg://ops_readonly:CHANGE_ME@cece-harness-dev172-postgres:5432/deerflow
#
# Option B — ops runs outside the Docker network, using the published port:
OPS_DATABASE_URL=postgresql+asyncpg://ops_readonly:CHANGE_ME@172.25.18.172:15432/deerflow

# database.postgres_schema from config.yaml. dev172 uses `deerflow`;
# a stock DeerFlow setup uses `public`.
OPS_DB_SCHEMA=deerflow

# Optional: map the user code from MySQL onto the PG email prefix.
# The table/column names are validated as SQL identifiers.
OPS_MYSQL_HOST=
OPS_MYSQL_PORT=3306
OPS_MYSQL_USER=
OPS_MYSQL_PASSWORD=
OPS_MYSQL_DB=a_sh_mgr
OPS_MYSQL_TABLE=st_mgr_user
OPS_MYSQL_CODE_COLUMN=code
OPS_MYSQL_MOBILE_COLUMN=mobile
OPS_CODE_CACHE_SECONDS=60
# Only emails on this domain are mapped; personal accounts keep their email.
OPS_MAP_EMAIL_DOMAIN=users.deerflow.internal

OPS_TZ=Asia/Shanghai
OPS_PORT=8099
# 127.0.0.1 = local/SSH tunnel only. A LAN IP shares it on that network.
OPS_BIND_HOST=127.0.0.1
OPS_MAX_DAYS=90
OPS_PAGE_LIMIT=200
OPS_STATEMENT_TIMEOUT_MS=5000

# Name of the application compose network (docker network ls).
# dev172: cece-harness-dev172-net
# test224: cece-harness-test224-net
DEER_FLOW_NETWORK=cece-harness-dev172-net